# 把下面三项改成你实际使用的模型服务（三选一）
# ── DeepSeek（推荐，便宜，注册就送额度）──────────────
API_KEY=在这里填你的Key
BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

